{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
"productName": "catan",
  "version": "0.1.15",
    "identifier": "com.catan.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "catan-game",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRjRDODJFMDYyODhDREYKUldUZmpDZ0dMc2owcTJPYTRUamh0L2ZLaVVYTkI4Q0ZQeWFWVXpPc3JMNEhYYU9UOEdJaUxJT1MK",
      "endpoints": [
        "https://github.com/ikabeshuka/catan/releases/latest/download/latest.json"
      ]
    }
  }
}